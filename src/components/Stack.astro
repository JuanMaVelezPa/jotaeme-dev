---
import { ui } from '../i18n';
import { content, getLocale } from '../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const data = content[locale];
---

<section class="stack" id={t.stack.id} aria-labelledby={`${t.stack.id}-title`}>
	<div class="head">
		<div class="titles">
			<p class="section-label" aria-hidden="true">03 — {t.stack.label}</p>
			<h2 id={`${t.stack.id}-title`}>{data.stack.titulo}</h2>
		</div>
		<p class="intro-text">{data.stack.descripcion}</p>
	</div>
	<ul class="grid">
		{
			data.habilidades.map((group, i) => (
				<li class="card card-hover reveal">
					<div class="card-head">
						<h3>{group.grupo}</h3>
						<span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					</div>
					<p>{group.items.join(', ')}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.stack {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 1rem 8rem;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.titles {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.section-label {
		margin: 0;
	}

	h2 {
		margin: 0;
		font-size: var(--jm-text-h2);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.intro-text {
		max-width: 380px;
		margin: 0;
		font-size: 16px;
		line-height: 1.6;
		color: var(--jm-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 1.75rem;
		border: 1px solid var(--jm-border);
		border-radius: var(--jm-radius-md);
		background: var(--jm-surface-2);
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	h3 {
		margin: 0;
		font-size: 18px;
		font-weight: 600;
	}

	.num {
		font-family: var(--jm-font-mono);
		font-size: 12px;
		color: var(--jm-dim);
	}

	.card p {
		margin: 0;
		font-size: 15px;
		line-height: 1.65;
		color: var(--jm-muted);
	}

	@media (max-width: 820px) {
		.stack {
			padding-bottom: 5rem;
		}
	}
</style>
