---
import { ui } from '../lib/i18n';
import { code, getLocale } from '../lib/content';
import ProjectCard from './project/ProjectCard.astro';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].code;
// 'soon' entries show only in the Projects menu.
const active = code.filter((project) => project.status === 'active');
---

<section class="category" aria-labelledby="code-title">
	<header class="head">
		<h1 id="code-title" class="anim" style="--i: 0">{t.title}</h1>
		<p class="intro-text anim" style="--i: 1">{t.intro}</p>
	</header>
	<ul class="list" aria-label={t.list}>
		{active.map((project) => <ProjectCard project={project} category="code" />)}
	</ul>
</section>

<style>
	.category {
		--cat: var(--jm-code);
		display: flex;
		flex-direction: column;
		gap: 3rem;
		max-width: 1240px;
		margin: 0 auto;
		padding: 3rem 1rem 8rem;
	}

	.head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	h1 {
		margin: 0;
		color: var(--cat);
	}

	/* The brand cursor after the title, blinking like the jm wordmark. */
	h1::after {
		content: '';
		display: inline-block;
		width: 0.07em;
		height: 0.82em;
		margin-left: 0.12em;
		background: var(--cat);
		animation: jm-blink var(--jm-dur-blink) steps(1) infinite;
	}

	@keyframes jm-blink {
		50% {
			opacity: 0;
		}
	}

	.intro-text {
		max-width: 52ch;
		margin: 0.5rem 0 0;
		font-size: 18px;
		line-height: 1.6;
		color: var(--jm-muted);
	}

	.list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Header entrance: title and intro arrive one after another. Only with JavaScript. */
	@media (prefers-reduced-motion: no-preference) {
		:global(.js) .anim {
			animation: jm-enter var(--jm-dur-enter) var(--jm-ease) both;
			animation-delay: calc(var(--i) * var(--jm-dur-enter) / 8);
		}

		:global(.loader-on) .anim,
		:global(.loader-on) h1::after {
			animation-play-state: paused;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		h1::after {
			animation: none;
		}
	}

	@media (max-width: 820px) {
		.category {
			padding-bottom: 5rem;
		}
	}
</style>
