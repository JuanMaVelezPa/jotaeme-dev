---
import { ui } from '../../lib/i18n';
import { content, getLocale } from '../../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const data = content[locale];
const [lead, ...tail] = data.sobre_mi.titular.split(': ');
const rest = tail.join(': ');
---

<section class="wide" id={t.about.id} aria-labelledby={`${t.about.id}-title`}>
	<div class="side">
		<p class="section-label" aria-hidden="true">01 — {t.about.label}</p>
	</div>
	<div class="main reveal">
		<h2 id={`${t.about.id}-title`}>{lead}{rest && <>: <span class="dim">{rest}</span></>}</h2>
		<p class="summary">{data.resumen}</p>
		<ul class="chips">
			{data.sobre_mi.chips.map((chip) => <li>{chip}</li>)}
		</ul>
		<div class="method">
			<h3 class="method-title">{data.sobre_mi.metodo_titulo}</h3>
			<ul class="method-list">
				{data.sobre_mi.metodo_puntos.map((point) => <li>{point}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.wide {
		display: flex;
		flex-wrap: wrap;
		gap: 4rem;
		max-width: 1240px;
		margin: 0 auto;
		padding: 8rem 1rem;
	}

	.side {
		flex: 1 1 300px;
		min-width: 0;
	}

	.main {
		display: flex;
		flex: 999 1 640px;
		flex-direction: column;
		gap: 2rem;
		min-width: 0;
	}

	.section-label {
		margin: 0;
	}

	h2 {
		margin: 0;
		font-size: var(--jm-text-h2);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: -0.03em;
	}

	.dim {
		color: var(--jm-dim);
	}

	.summary {
		max-width: 720px;
		margin: 0;
		color: var(--jm-muted);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.chips li {
		margin: 0;
		padding: 8px 14px;
		border: 1px solid var(--jm-border);
		border-radius: var(--jm-radius-pill);
		font-size: 14px;
		line-height: 1.5;
	}

	.method {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 720px;
		padding-top: 2rem;
		border-top: 1px solid var(--jm-border);
	}

	.method-title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.method-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--jm-muted);
	}

	.method-list li {
		margin: 0;
	}

	@media (max-width: 820px) {
		.wide {
			gap: 1.5rem;
			padding: 5rem 1rem;
		}
	}
</style>
