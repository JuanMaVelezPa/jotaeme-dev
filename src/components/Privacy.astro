---
import site from '../content/site.json';
import { ui } from '../lib/i18n';
import { getLocale, privacy } from '../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].privacy;
const text = privacy[locale];
const updated = new Intl.DateTimeFormat(locale === 'es' ? 'es-CO' : 'en-US', {
	dateStyle: 'long',
	timeZone: 'UTC',
}).format(new Date(`${privacy.updated}T00:00:00Z`));

// "{email}" in the text becomes a mailto link to the public contact address.
const parts = (paragraph: string) => paragraph.split('{email}');
---

<article class="privacy" aria-labelledby="privacy-title">
	<header class="head">
		<h1 id="privacy-title">{t.title}</h1>
		<p class="updated">{t.updated} <time datetime={privacy.updated}>{updated}</time></p>
		<p class="intro-text">{text.intro}</p>
	</header>
	{
		text.sections.map((section) => (
			<section>
				<h2>{section.title}</h2>
				{section.paragraphs.map((paragraph) => (
					<p>
						{parts(paragraph).map((piece, i) => (
							<>
								{i > 0 && <a href={`mailto:${site.email}`}>{site.email}</a>}
								{piece}
							</>
						))}
					</p>
				))}
				{section.links && (
					<ul class="links">
						{section.links.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noopener noreferrer">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		))
	}
</article>

<style>
	.privacy {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		max-width: 46rem;
		margin: 0 auto;
		padding: 3rem 1rem 8rem;
	}

	.head {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.privacy h1 {
		margin: 0;
		font-size: var(--jm-text-h2);
	}

	.updated {
		margin: 0;
		font-family: var(--jm-font-mono);
		font-size: var(--jm-text-label);
		color: var(--jm-dim);
	}

	.intro-text {
		margin: 0.5rem 0 0;
		color: var(--jm-muted);
	}

	.privacy h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}

	.privacy p {
		margin: 0 0 1rem;
		color: var(--jm-muted);
		overflow-wrap: anywhere;
	}

	.links {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--jm-muted);
	}

	@media (max-width: 820px) {
		.privacy {
			padding-bottom: 5rem;
		}
	}
</style>
