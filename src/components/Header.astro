---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui } from '../i18n';

const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
const other = locale === 'es' ? 'en' : 'es';
const t = ui[locale];
const links = [t.about, t.experience, t.services, t.contact];
---

<header class="site-header">
	<div class="container">
		<nav aria-label={t.nav}>
			<ul>
				{links.map((link) => <li><a href={`#${link.id}`}>{link.label}</a></li>)}
			</ul>
		</nav>
		<a class="lang-link" href={getRelativeLocaleUrl(other)} hreflang={other} lang={other} aria-label={ui[other].language}>
			{other.toUpperCase()}
		</a>
	</div>
</header>
