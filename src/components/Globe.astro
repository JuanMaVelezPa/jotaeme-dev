---
interface Props {
	labels: string[];
}

const { labels } = Astro.props;
const meridians = [0, 30, 60, 90, 120, 150];
const size = 380;
const parallels = [-127, -63, 0, 63, 127].map((z) => {
	const diameter = Math.round(2 * Math.sqrt((size / 2) ** 2 - z ** 2));
	return { z, diameter, offset: (size - diameter) / 2 };
});
const chips = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'];
---

<div class="globe-wrap" aria-hidden="true">
	<div class="scene">
		<div class="tilt" id="globe-tilt">
			<div class="globe">
				{meridians.map((deg) => <div class="ring" style={`transform: rotateY(${deg}deg)`} />)}
				{
					parallels.map((p) => (
						<div
							class:list={['ring', 'parallel', { equator: p.z === 0 }]}
							style={`left: ${p.offset}px; top: ${p.offset}px; width: ${p.diameter}px; height: ${p.diameter}px; transform: rotateX(90deg) translateZ(${p.z}px)`}
						/>
					))
				}
			</div>
			<div class="orbitwrap orbit-a"><div class="orbit"><span class="dot"></span></div></div>
			<div class="orbitwrap orbit-b"><div class="orbit2"><span class="dot dot-small"></span></div></div>
			<span class="core"></span>
		</div>
	</div>
	{labels.map((label, i) => <span class={`chip float ${chips[i % chips.length]}`}>{label}</span>)}
</div>

<script>
	const tilt = document.getElementById('globe-tilt');
	const quiet = window.matchMedia('(prefers-reduced-motion: reduce)');
	const finePointer = window.matchMedia('(pointer: fine)');

	if (tilt && !quiet.matches && finePointer.matches) {
		window.addEventListener('pointermove', (event) => {
			const x = event.clientX / window.innerWidth - 0.5;
			const y = event.clientY / window.innerHeight - 0.5;
			tilt.style.transform = `rotateX(${14 - y * 12}deg) rotateY(${x * 18}deg)`;
		});
	}
</script>

<style>
	.globe-wrap {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 480px;
		overflow: clip;
	}

	.scene {
		position: relative;
		width: 380px;
		height: 380px;
		perspective: 1100px;
	}

	.tilt {
		position: absolute;
		inset: 0;
		transform: rotateX(14deg) rotateY(0deg);
		transform-style: preserve-3d;
		transition: transform 0.6s var(--jm-ease);
	}

	.globe {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
	}

	.ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--jm-bone), transparent 84%);
	}

	.parallel {
		inset: auto;
		border-color: color-mix(in srgb, var(--jm-bone), transparent 88%);
	}

	.equator {
		border-color: color-mix(in srgb, var(--jm-bone), transparent 55%);
	}

	.orbitwrap {
		position: absolute;
		transform-style: preserve-3d;
	}

	.orbit-a {
		inset: -80px;
		transform: rotateX(74deg) rotateY(-14deg);
	}

	.orbit-b {
		inset: -40px;
		transform: rotateX(62deg) rotateY(38deg);
	}

	.orbit,
	.orbit2 {
		position: absolute;
		inset: 0;
		border-radius: 50%;
	}

	.orbit {
		border: 1px dashed color-mix(in srgb, var(--jm-bone), transparent 65%);
	}

	.orbit2 {
		border: 1px solid color-mix(in srgb, var(--jm-bone), transparent 92%);
	}

	.dot {
		position: absolute;
		left: 50%;
		top: -6px;
		width: 12px;
		height: 12px;
		margin-left: -6px;
		border-radius: 50%;
		background: var(--jm-bone);
		box-shadow: 0 0 18px var(--jm-bone);
	}

	.dot-small {
		top: auto;
		bottom: -4px;
		width: 8px;
		height: 8px;
		margin-left: -4px;
		box-shadow: none;
	}

	.core {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 10px;
		height: 10px;
		margin: -5px 0 0 -5px;
		border-radius: 50%;
		background: var(--jm-bone);
		box-shadow: 0 0 40px 8px color-mix(in srgb, var(--jm-bone), transparent 65%);
	}

	.chip {
		position: absolute;
		padding: 8px 12px;
		border: 1px solid var(--jm-border-strong);
		border-radius: 10px;
		background: color-mix(in srgb, var(--jm-surface), transparent 12%);
		font-family: var(--jm-font-mono);
		font-size: 13px;
		line-height: 1.4;
		color: var(--jm-bone);
		white-space: nowrap;
	}

	.c1 { left: 4%; top: 14%; }
	.c2 { right: 2%; top: 10%; animation-delay: -1.5s; }
	.c3 { right: 0; top: 52%; animation-delay: -3s; }
	.c4 { left: 0; top: 58%; animation-delay: -4.5s; }
	.c5 { left: 18%; bottom: 4%; animation-delay: -2.2s; }
	.c6 { right: 14%; bottom: 8%; animation-delay: -5.2s; }

	@media (prefers-reduced-motion: no-preference) {
		.globe {
			animation: spin 36s linear infinite;
		}

		.orbit {
			animation: spinz 14s linear infinite;
		}

		.orbit2 {
			animation: spinz 22s linear infinite reverse;
		}

		.float {
			animation: bob 6s ease-in-out infinite;
		}
	}

	@keyframes spin {
		to { transform: rotateY(360deg); }
	}

	@keyframes spinz {
		to { transform: rotateZ(360deg); }
	}

	@keyframes bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	@media (max-width: 820px) {
		.globe-wrap {
			height: 400px;
		}

		.scene {
			transform: scale(0.78);
		}
	}
</style>
