---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui } from '../../lib/i18n';
import { content, getLocale, labs, projects } from '../../lib/content';

interface Props {
	id: string;
	home: string;
}

const { id, home } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const titles = Object.fromEntries(content[locale].ecosistema.tarjetas.map((card) => [card.id, card.titulo]));
const labPage = getRelativeLocaleUrl(locale, 'lab/');

// One markup for both layouts: a full-width panel on desktop, an accordion body on mobile.
const columns = [
	{ id: 'code', items: projects.filter((p) => p.category === 'code').map((p) => ({ name: p.name, href: p.href })) },
	{ id: 'apps', items: projects.filter((p) => p.category === 'apps').map((p) => ({ name: p.name, href: p.href })) },
	{
		id: 'lab',
		items: labs.map((lab) => ({ name: lab[locale].title, href: lab.live, status: lab.status })),
	},
];
---

<div class="projects-panel" id={id}>
	<div class="projects-inner">
		<div class="cols">
			{
				columns.map((col) => (
					<div class={`col c-${col.id}`} role="group" aria-labelledby={`${id}-${col.id}`}>
						<h3 id={`${id}-${col.id}`}>{titles[col.id]}</h3>
						<ul>
							{col.items.length === 0 && (
								<li>
									<span class="item"><span class="tag">{t.projectsMenu.soon}</span></span>
								</li>
							)}
							{col.items.map((item) => {
								const inner = (
									<>
										{'status' in item && <span class="dot" data-status={item.status} aria-hidden="true" />}
										<span class="name">{item.name}</span>
										{'status' in item && <span class="sr-only"> · {t.lab.status[item.status]}</span>}
										{col.id === 'code' && !item.href && <span class="tag">{t.projectsMenu.soon}</span>}
									</>
								);
								return (
									<li>
										{item.href ? (
											<a class="item" href={item.href} target="_blank" rel="noopener noreferrer">{inner}</a>
										) : (
											<span class="item">{inner}</span>
										)}
									</li>
								);
							})}
						</ul>
						{col.id === 'lab' && (
							<a class="more" href={labPage}>{t.projectsMenu.seeAll} {titles.lab} →</a>
						)}
					</div>
				))
			}
		</div>
		<a class="more overview" href={`${home}#${t.ecosystem.id}`}>{t.projectsMenu.overview} →</a>
	</div>
</div>

<style>
	/* Without JavaScript the Projects item stays a plain link, so the panel never shows. */
	.projects-panel {
		display: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2.5rem;
	}

	.col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		--col: var(--jm-bone);
	}

	.c-code { --col: var(--jm-code); }
	.c-apps { --col: var(--jm-apps); }
	.c-lab { --col: var(--jm-lab); }

	h3 {
		margin: 0;
		font-family: var(--jm-font-mono);
		font-size: var(--jm-text-label);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--col);
	}

	ul {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		color: var(--jm-bone);
		font-size: 17px;
		text-decoration: none;
	}

	a.item:hover,
	.more:hover {
		color: var(--jm-accent);
	}

	.name {
		font-family: var(--jm-font-mono);
		font-size: 15px;
	}

	.tag {
		padding: 2px 10px;
		border: 1px solid var(--jm-border-strong);
		border-radius: var(--jm-radius-pill);
		font-family: var(--jm-font-mono);
		font-size: 12px;
		line-height: 1.5;
		color: var(--jm-muted);
	}

	.dot {
		flex: none;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--jm-lab);
	}

	.dot[data-status='paused'],
	.dot[data-status='archived'] {
		background: transparent;
		box-shadow: inset 0 0 0 1px var(--jm-dim);
	}

	.more {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--jm-muted);
		font-size: 15px;
		text-decoration: none;
	}

	.overview {
		margin-top: 1rem;
	}

	:global(.js) :global(.projects-toggle[aria-expanded='true']) ~ .projects-panel {
		display: block;
	}

	/* Mobile: the accordion body, stacked columns inside the nav panel. */
	@media (max-width: 820px) {
		.projects-inner {
			padding: 0.75rem 0 1rem 0.5rem;
		}

		.cols {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.overview {
			margin-top: 0;
		}
	}

	@media (min-width: 821px) {
		.projects-panel {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--jm-ink);
			border-bottom: 1px solid var(--jm-border);
		}

		.projects-inner {
			box-sizing: border-box;
			max-width: 1240px;
			margin: 0 auto;
			padding: 2rem 1.5rem 1.5rem;
		}

		.overview {
			padding-top: 0.5rem;
			border-top: 1px solid var(--jm-border);
			width: 100%;
		}

		@media (prefers-reduced-motion: no-preference) {
			:global(.js) :global(.projects-toggle[aria-expanded='true']) ~ .projects-panel {
				animation: panel-in var(--jm-dur-fast) var(--jm-ease);
			}
		}
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
	}
</style>
