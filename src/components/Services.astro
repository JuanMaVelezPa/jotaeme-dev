---
import { ui } from '../i18n';
import { content, getLocale } from '../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const data = content[locale];
---

<section class="services" id={t.services.id} aria-labelledby={`${t.services.id}-title`}>
	<div class="titles">
		<p class="section-label" aria-hidden="true">04 — {t.services.label}</p>
		<h2 id={`${t.services.id}-title`}>{data.servicios_seccion.titulo}</h2>
	</div>
	<ul class="grid">
		{
			data.servicios.map((service, i) => (
				<li class="card card-hover reveal">
					<span class="num" aria-hidden="true">/{String(i + 1).padStart(2, '0')}</span>
					<h3>{service.titulo}</h3>
					<p>{service.descripcion}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.services {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 1rem 8rem;
	}

	.titles {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.section-label {
		margin: 0;
	}

	h2 {
		margin: 0;
		font-size: var(--jm-text-h2);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 2rem;
		border: 1px solid var(--jm-border);
		border-radius: var(--jm-radius-md);
		background: var(--jm-surface-2);
	}

	.num {
		font-family: var(--jm-font-mono);
		font-size: var(--jm-text-label);
		color: var(--jm-dim);
	}

	h3 {
		margin: 0;
		font-size: 22px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}

	.card p {
		margin: 0;
		font-size: 16px;
		line-height: 1.6;
		color: var(--jm-muted);
	}

	@media (max-width: 820px) {
		.services {
			padding-bottom: 5rem;
		}
	}
</style>
